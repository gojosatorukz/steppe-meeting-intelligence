# Copy to .env and adjust if needed. No API keys — this product makes no
# outbound network calls at runtime.
#   cp .env.example .env

STT_DEVICE=auto          # auto|cuda|cpu — which device runs faster-whisper
LLM_MODEL=qwen3.5:4b     # Ollama model name for protocol generation
DIARIZE_THRESHOLD=0.7
OFFLINE_GUARD=1          # 1 = block/count any non-loopback network connection
HF_HUB_OFFLINE=1         # 1 = never let huggingface_hub touch the network
LIVE_VAD_MAX_SPEECH=12   # max seconds per VAD-cut utterance on the live path
PORT=8000                # uvicorn port
